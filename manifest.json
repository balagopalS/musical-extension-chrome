{
  "manifest_version": 3,
  "name": "Musical Extension - BPM & Key Finder",
  "version": "1.0.0",
  "description": "Real-time client-side DSP audio analysis to detect BPM, musical key, Camelot notation, and song info on YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://itunes.apple.com/*",
    "https://musicbrainz.org/*",
    "https://openrouter.ai/*",
    "https://api.tavily.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/detector.ts"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
